-- ============================================
-- ГЛАВНЫЙ RENDERSTEPPED ЦИКЛ
-- ============================================
local RayParams = RaycastParams.new()
RayParams.FilterType = Enum.RaycastFilterType.Exclude

local MainHandler = RS.RenderStepped:Connect(function()
    -- Обновление камеры
    local c = workspace:FindFirstChild("Camera")
    if c then Camera = c end
    if not Camera then Camera = workspace.CurrentCamera end
    if not Camera then return end

    -- Обновление ссылок на персонажа при смене
    if LP.Character and Character ~= LP.Character then
        UpdateCharacter(LP.Character)
    end

    -- ============================================
    -- CAMERA: Ambient
    -- ============================================
    if T.AmbientToggle and C.AmbientColor then
        TS:Create(Lighting, TweenInfo.new(0.2, Enum.EasingStyle.Exponential), {
            Ambient = C.AmbientColor,
        }):Play()
    end

    -- ============================================
    -- CAMERA: FOV
    -- ============================================
    if T.FOVToggle and S.FieldOfView then
        if Main_Game then
            Main_Game.fovtarget = S.FieldOfView
        else
            Camera.FieldOfView = S.FieldOfView
        end
    end

    -- ============================================
    -- CAMERA: Remove Shake / Bobbing / Viewmodel
    -- ============================================
    if Main_Game then
        if T.RemoveCameraShake then Main_Game.csgo = CFrame.new() end
        if T.RemoveCameraBobbing then Main_Game.spring.Speed = 9e9 end

        if T.ViewmodelOffsetToggle then
            Main_Game.tooloffset = Vector3.new(
                S.ViewmodelOffsetX or 0,
                S.ViewmodelOffsetY or 0,
                S.ViewmodelOffsetZ or 0
            )
        else
            Main_Game.tooloffset = Vector3.zero
        end
    end

    -- ============================================
    -- CAMERA: Remove Fog
    -- ============================================
    if T.RemoveCameraFog then
        Lighting.FogEnd = 10000000
        for _, obj in ipairs(Globals.FogInstances) do
            if obj.Parent then obj.Density = 0 end
        end
    end

    -- ============================================
    -- CAMERA: Third Person
    -- ============================================
    if T.ThirdPersonToggle and Character and Camera then
        local TPOffset = CFrame.new(
            S.ThirdPersonOffsetX or 1.5,
            S.ThirdPersonOffsetY or 1,
            S.ThirdPersonOffsetZ or 5
        )
        RayParams.FilterDescendantsInstances = { Character }
        local Direction = (Camera.CFrame * TPOffset).Position - Camera.CFrame.Position
        local WallResult = workspace:Spherecast(Camera.CFrame.Position, 0.2, Direction, RayParams)

        if T.ThirdPersonWallCheck and WallResult and WallResult.Instance.CanCollide then
            local NewPos = Camera.CFrame.Position + Direction.Unit * WallResult.Distance
            Camera.CFrame = CFrame.new(NewPos, NewPos + Camera.CFrame.LookVector)
        else
            Camera.CFrame = Camera.CFrame * TPOffset
        end

        for _, part in ipairs(Globals.ThirdPersonParts) do
            if part and part.Parent then
                part.Transparency = 0
                part.LocalTransparencyModifier = 0
            end
        end
    else
        for _, part in ipairs(Globals.ThirdPersonParts or {}) do
            if part and part.Parent then
                part.LocalTransparencyModifier = 1
            end
        end
    end

    -- ============================================
    -- EFFECTS: Vignette / Jumpscares
    -- ============================================
    if MainUI then
        local Vignette = MainUI:FindFirstChild("HideVignette")
            or (MainUI:FindFirstChild("MainFrame") and MainUI.MainFrame:FindFirstChild("HideVignette"))
        if Vignette then
            if T.DisableHideVignette then
                Vignette.Image = "Disabled"
            else
                Vignette.Image = "rbxassetid://6100076320"
            end
        end
    end

    -- ============================================
    -- ГЛАВНЫЕ ФЛАГИ
    -- ============================================
    Globals.IsEyes = workspace:FindFirstChild("Eyes") ~= nil
        or workspace:FindFirstChild("Lookman") ~= nil
    Globals.IsLookman = workspace:FindFirstChild("BackdoorLookman") ~= nil
end)

keep(MainHandler)
