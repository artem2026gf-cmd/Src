local OBSIDIAN_URL = "https://raw.githubusercontent.com/deividcomson/obsidian-lib/main/source.lua"

local function fetch(url)
    if game.HttpGet then
        local ok, res = pcall(function() return game:HttpGet(url, true) end)
        if ok and res and #res > 100 and not res:find("<!DOCTYPE") then return res end
    end
    if request then
        local ok, res = pcall(function() return request({Url=url, Method="GET"}) end)
        if ok and res and res.Body and #res.Body > 100 then return res.Body end
    end
    return nil
end

local function showError(msg)
    warn("[Abysall Visuals] " .. tostring(msg))
end

local ok, Obsidian = pcall(function()
    local src = fetch(OBSIDIAN_URL)
    if not src then error("Failed to download Obsidian") end
    local fn, err = loadstring(src)
    if not fn then error("Compile: " .. tostring(err)) end
    return fn()
end)

if not ok or type(Obsidian) ~= "table" then
    showError("Obsidian load failed: " .. tostring(Obsidian))
    return
end

getgenv().Obsidian = Obsidian
print("[Abysall Visuals] Part 1/8 — Obsidian loaded")
