local HidingSpotLabels = {
    Wardrobe = "Closet",
    ["Backdoor_Wardrobe"] = "Closet",
    Toolshed = "Closet",
    RetroWardrobe = "Closet",
    ["Wardrobe-FOOLS26"] = "Closet",
    Locker_Large = "Locker",
    Rooms_Locker = "Hiding_Spot",
    Rooms_Locker_Fridge = "Locker",
    Bed = "Bed",
    Double_Bed = "Double Bed",
    CircularVent = "Vent",
    Dumpster = "Dumpster",
}

keep(workspace.DescendantAdded:Connect(function(obj)
    if not obj:IsA("Model") then return end

    local name = obj.Name
    if HidingSpotLabels[name] or string.find(string.lower(name), "hidingspot") then
        table.insert(Objects.HidingSpots, obj)

        local Parts = {}
        for _, part in ipairs(obj:GetDescendants()) do
            if part:IsA("BasePart") then
                part:SetAttribute("Transparency_Old", part.Transparency)
                table.insert(Parts, part)
            end
        end
        for _, part in ipairs(obj:GetDescendants()) do
            if part.Name == "HiddenPlayer" then
                local hideConn = part:GetPropertyChangedSignal("Value"):Connect(function()
                    if not T.TransparentHidingSpotsToggle then return end
                    for _, p in ipairs(Parts) do
                        local oldT = p:GetAttribute("Transparency_Old")
                        if oldT then
                            TS:Create(p, TweenInfo.new(0.25, Enum.EasingStyle.Linear), {
                                Transparency = (part.Value == Character and T.TransparentHidingSpotsToggle)
                                    and (S.TransparentHidingSpotsSlider or 0.5)
                                    or oldT
                            }):Play()
                        end
                    end
                end)
                obj.Destroying:Once(function() hideConn:Disconnect() end)
                keep(hideConn)
            end
        end
    end
end))

