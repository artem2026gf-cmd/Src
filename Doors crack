    local conn = obj:GetPropertyChangedSignal("Density"):Connect(function()
        if obj.Density ~= 0 then obj:SetAttribute("Density_Old", obj.Density) end
        if T.RemoveCameraFog then obj.Density = 0 end
    end)
    obj.Destroying:Once(function() conn:Disconnect() end)
    table.insert(Globals.FogInstances, obj)
end))

for _, obj in ipairs(Lighting:GetChildren()) do
    if obj:IsA("Atmosphere") then
