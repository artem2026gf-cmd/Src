local Character, Humanoid, RootPart, Camera
local Collision, CollisionPart, CollisionClone, CollisionPartClone
local MainUI, Main_Game

local function UpdateCharacter(newChar)
    if not newChar then return end
    Character = newChar
    Humanoid = newChar:WaitForChild("Humanoid", 10)
    RootPart = newChar:FindFirstChild("HumanoidRootPart")
    Collision = newChar:WaitForChild("Collision", 10)
    CollisionPart = newChar:FindFirstChild("CollisionPart") or Collision

    if Collision and not newChar:FindFirstChild("CollisionClone") then
        CollisionClone = Collision:Clone()
        CollisionClone.Name = "CollisionClone"
        CollisionClone.Massless = true
        CollisionClone.Parent = newChar
    else
        CollisionClone = newChar:FindFirstChild("CollisionClone")
    end

    if CollisionPart and not newChar:FindFirstChild("CollisionPartClone") then
        CollisionPartClone = CollisionPart:Clone()
        CollisionPartClone.Name = "CollisionPartClone"
        CollisionPartClone.CanCollide = false
        CollisionPartClone.Massless = true
        if CollisionPartClone:FindFirstChild("CollisionCrouch") then
            CollisionPartClone.CollisionCrouch:Destroy()
        end
        CollisionPartClone.Parent = newChar
    else
        CollisionPartClone = newChar:FindFirstChild("CollisionPartClone")
    end

    Globals.OriginalC1 = nil
    pcall(function()
        if newChar:FindFirstChild("LowerTorso") and newChar.LowerTorso:FindFirstChild("Root") then
            Globals.OriginalC1 = newChar.LowerTorso.Root.C1
        end
    end)

    Globals.ThirdPersonParts = {}
    for _, obj in ipairs(newChar:GetDescendants()) do
        if obj:IsA("Accessory") and obj:FindFirstChild("Handle") then
            table.insert(Globals.ThirdPersonParts, obj.Handle)
        end
    end
    if newChar:FindFirstChild("Head") then
        table.insert(Globals.ThirdPersonParts, newChar.Head)
    end
end

if LP.Character then
    task.spawn(function() UpdateCharacter(LP.Character) end)
end
keep(LP.CharacterAdded:Connect(function(c)
    task.wait(0.5)
    UpdateCharacter(c)
end))

